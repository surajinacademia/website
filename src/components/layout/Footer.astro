---
import { navLinks, siteConfig } from "@/site.config";

const year = new Date().getFullYear();
---

<footer class="mt-auto w-full">
	<div class="mx-auto max-w-[1100px] border-t border-gray-200 py-12 dark:border-neutral-800">
		<div class="mx-auto grid grid-cols-1 gap-6 text-center">
			<nav
				aria-labelledby="footer_links"
				class="text-global-text flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm"
			>
				<p id="footer_links" class="sr-only">More on this site</p>
				{
					navLinks.map((link) => (
						<a class="hover:text-link transition duration-300 hover:underline" href={link.path}>
							{link.title}
						</a>
					))
				}
			</nav>
			<p class="text-global-text text-center text-xs">
				&copy; {year}
				{siteConfig.author}. Built with Astro; design based on the
				<a
					class="cactus-link"
					href="https://github.com/JoaoFranco03/photography-portfolio"
					target="_blank"
					rel="noopener">Photography Portfolio</a
				>
				template by João Franco.
			</p>
		</div>
	</div>
</footer>
