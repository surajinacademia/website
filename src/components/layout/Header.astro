---
import Search from "@/components/Search.astro";
import SocialList from "@/components/SocialList.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { navLinks, siteConfig } from "@/site.config";
---

<div class="mb-4 flex justify-end">
	<SocialList />
</div>
<header
	class="group relative mb-16 flex flex-wrap items-center justify-between gap-4 border-b border-gray-200 pb-4 dark:border-white/10"
	id="main-header"
>
	<a
		aria-current={Astro.url.pathname === "/" ? "page" : false}
		class="text-accent-2 shrink-0 text-lg font-semibold tracking-wider uppercase sm:text-xl"
		href="/"
	>
		{siteConfig.title}
	</a>
	<nav
		aria-label="Main menu"
		class="bg-global-bg pointer-events-none invisible absolute top-full right-0 left-0 z-50 flex -translate-y-1 flex-col gap-1 border-y border-gray-200 px-4 py-4 opacity-0 shadow-lg transition-[opacity,transform,visibility] duration-150 ease-out group-[.menu-open]:pointer-events-auto group-[.menu-open]:visible group-[.menu-open]:translate-y-0 group-[.menu-open]:opacity-100 motion-reduce:transition-none sm:pointer-events-auto sm:visible sm:static sm:flex sm:translate-y-0 sm:flex-row sm:gap-6 sm:border-0 sm:px-0 sm:py-0 sm:opacity-100 sm:shadow-none sm:transition-none dark:border-white/10"
		id="navigation-menu"
	>
		{
			navLinks.map((link) => (
				<a
					aria-current={Astro.url.pathname === link.path ? "page" : false}
					class="text-accent-2 text-sm font-medium tracking-wide uppercase hover:underline aria-[current=page]:underline sm:py-0 sm:underline-offset-4"
					href={link.path}
				>
					{link.title}
				</a>
			))
		}
	</nav>
	<div class="flex shrink-0 items-center gap-2">
		<Search />
		<ThemeToggle />
		<mobile-button class="sm:hidden">
			<button
				aria-expanded="false"
				aria-haspopup="menu"
				class="text-global-text relative flex h-9 w-9 items-center justify-center rounded-md hover:bg-gray-200 dark:hover:bg-gray-700"
				id="toggle-navigation-menu"
				type="button"
			>
				<span class="sr-only" data-menu-label>Open main menu</span>
				<svg
					aria-hidden="true"
					class="absolute start-1/2 top-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 transition-[opacity,transform] duration-150 ease-out group-aria-expanded:scale-0 group-aria-expanded:opacity-0 motion-reduce:transition-none"
					fill="none"
					focusable="false"
					id="line-svg"
					stroke="currentColor"
					stroke-width="1.5"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path d="M3.75 9h16.5m-16.5 6.75h16.5" stroke-linecap="round" stroke-linejoin="round"
					></path>
				</svg>
				<svg
					aria-hidden="true"
					class="text-accent absolute start-1/2 top-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 scale-0 opacity-0 transition-[opacity,transform] duration-150 ease-out group-aria-expanded:scale-100 group-aria-expanded:opacity-100 motion-reduce:transition-none"
					fill="none"
					focusable="false"
					id="cross-svg"
					stroke="currentColor"
					stroke-width="1.5"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</button>
		</mobile-button>
	</div>
</header>

<script>
	import { toggleClass } from "@/utils/domElement";

	class MobileNavBtn extends HTMLElement {
		#controller = new AbortController();
		#menuOpen: boolean = false;

		connectedCallback() {
			this.#controller = new AbortController();
			const headerEl = document.getElementById("main-header")!;
			const mobileButtonEl = this.querySelector<HTMLButtonElement>("button");
			const menuLabelEl = this.querySelector<HTMLElement>("[data-menu-label]");
			const desktopQuery = window.matchMedia("(min-width: 640px)");
			const { signal } = this.#controller;

			const setMenuOpen = (open: boolean) => {
				if (this.#menuOpen !== open) toggleClass(headerEl, "menu-open");
				this.#menuOpen = open;
				mobileButtonEl?.setAttribute("aria-expanded", open.toString());
				if (menuLabelEl) menuLabelEl.textContent = open ? "Close main menu" : "Open main menu";
			};

			mobileButtonEl?.addEventListener("click", () => setMenuOpen(!this.#menuOpen), { signal });
			document.addEventListener(
				"pointerdown",
				(event) => {
					if (this.#menuOpen && !headerEl.contains(event.target as Node)) setMenuOpen(false);
				},
				{ signal },
			);
			document.addEventListener(
				"keydown",
				(event) => {
					if (event.key !== "Escape" || !this.#menuOpen) return;
					setMenuOpen(false);
					mobileButtonEl?.focus();
				},
				{ signal },
			);
			desktopQuery.addEventListener(
				"change",
				(event) => {
					if (event.matches) setMenuOpen(false);
				},
				{ signal },
			);
		}

		disconnectedCallback() {
			this.#controller.abort();
		}
	}

	customElements.define("mobile-button", MobileNavBtn);
</script>
