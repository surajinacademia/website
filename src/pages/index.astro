---
import SocialList from "@/components/SocialList.astro";
import PageLayout from "@/layouts/Base.astro";
---

<PageLayout
	searchable
	meta={{
		title: "About",
		description:
			"Graduate researcher at UC Merced studying collective cell dynamics, multicellular networks, cell adhesion, and pattern formation",
	}}
>
	<div class="pb-16">
		<section aria-label="Introduction" class="mb-12">
			<div class="container mx-auto">
			<div class="grid grid-cols-2 gap-14 md:gap-20">
				<div class="col-span-2 w-full md:col-span-1">
					<div
						class="relative m-6 w-full max-w-full -rotate-6 border border-gray-100 bg-white p-3 pb-12 shadow-lg transition duration-500 hover:rotate-0 motion-reduce:transition-none md:m-12 dark:border-neutral-800 dark:bg-neutral-900"
					>
						<img
							src="/icons/profile.jpg"
							alt="Suraj Sahu"
							class="block aspect-square w-full max-w-full bg-gray-100 object-contain dark:bg-neutral-800"
						/>
						<span
							class="text-accent-2 block pt-3 text-center text-lg font-semibold tracking-wider uppercase sm:text-xl"
							>SURAJ!</span
						>
					</div>
				</div>
				<div class="col-span-2 min-w-0 md:col-span-1">
					<h1 class="sr-only">Suraj Sahu</h1>
					<p class="text-global-text mb-5 leading-relaxed">
						I am a graduate researcher in the <a
							class="cactus-link"
							href="http://gopinathanlab.ucmerced.edu"
							target="_blank"
							rel="noopener">Gopinathan Lab</a
						> at the <a
							class="cactus-link"
							href="https://www.ucmerced.edu"
							target="_blank"
							rel="noopener">University of California, Merced</a
						>. My curiosity lies at the interface of biology and physics. More recently, I have
						started thinking about the mechanics of learning.
					</p>
					<p class="text-global-text mb-5 leading-relaxed">
						My research focuses on the collective dynamics of cell–cell and cell–matrix interactions,
						including multicellular network formation, cell adhesion, and pattern formation. I use
						agent-based modeling, numerical methods, network analysis, and network mechanics, along
						with some image analysis.
					</p>
					<p class="text-global-text mb-5 leading-relaxed">
						I also sometimes play with agentic tools and workflows for reproducible computation and
						AI-assisted image analysis. I have organized hands-on STEM outreach. I have also mentored
						graduate students through GradExcel, led journal club, and contributed to the trainee
						leadership council, helping organize professional development workshops and networking
						events.
					</p>
					<nav aria-label="Social profiles" class="mt-6 flex justify-start">
						<SocialList />
					</nav>
				</div>

			</div>
			</div>
		</section>

		<aside class="mx-auto mb-12 max-w-4xl text-gray-600 dark:text-gray-400">
			<p class="mb-4 leading-relaxed last:mb-0">
				I am neurodivergent. I live with ADHD and OCD. It’s always been a struggle to survive in
				academia.
			</p>
			<p class="mb-4 leading-relaxed last:mb-0">
				My approach towards work may be different from yours. Sometimes, the things I can do amaze
				even me. At other times, even moving is hard. I believe that our true potential comes from
				empathy and from an environment that helps us feel our best.
			</p>
			<p class="mb-4 leading-relaxed last:mb-0">
				I will try my best not to let this hinder our working relationship, and I will be clear
				in our communication.
			</p>
		</aside>

		<section aria-labelledby="affiliations" class="mx-auto max-w-4xl border-t border-gray-200 pt-8 dark:border-white/10">
			<h2 id="affiliations" class="text-accent-2 mb-6 text-xl font-semibold">Affiliations</h2>
			<div class="grid gap-6 md:grid-cols-3">
				<div class="group flex items-start gap-3">
					<a
						href="https://www.ucmerced.edu"
						target="_blank"
						rel="noopener"
						class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-white"
					>
						<img src="/icons/ucmerced.webp" alt="UC Merced" class="h-10 w-10 object-contain" />
					</a>
					<div class="min-w-0">
						<a
							class="cactus-link text-global-text hover:text-accent-2 font-semibold"
							href="https://www.ucmerced.edu"
							target="_blank"
							rel="noopener">University of California Merced</a
						>
						<p class="text-global-text mt-1 text-sm opacity-75">
							Graduate Researcher, <a
								class="cactus-link"
								href="http://gopinathanlab.ucmerced.edu"
								target="_blank"
								rel="noopener">Gopinathan Group</a
							>
						</p>
						<p class="text-global-text mt-0.5 text-sm opacity-75">
							<a
								class="cactus-link"
								href="https://physics.ucmerced.edu"
								target="_blank"
								rel="noopener">Department of Physics</a
							>
						</p>
					</div>
				</div>
				<a
					href="https://cemb.upenn.edu"
					target="_blank"
					rel="noopener"
					class="group flex items-start gap-3"
				>
					<div
						class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-white"
					>
						<img src="/icons/cemb.png" alt="CEMB" class="h-10 w-10 object-contain" />
					</div>
					<div class="min-w-0">
						<p class="cactus-link text-global-text group-hover:text-accent-2 font-semibold">
							Center for Engineering MechanoBiology
						</p>
						<p class="text-global-text mt-1 text-sm opacity-75">UPenn</p>
					</div>
				</a>
				<a
					href="https://ccbm.ucmerced.edu"
					target="_blank"
					rel="noopener"
					class="group flex items-start gap-3"
				>
					<div
						class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-white"
					>
						<img src="/icons/ccbm.png" alt="CCBM" class="h-10 w-10 object-contain" />
					</div>
					<div class="min-w-0">
						<p class="cactus-link text-global-text group-hover:text-accent-2 font-semibold">
							Center for Cellular and Biomolecular Machines
						</p>
					</div>
				</a>
			</div>
		</section>
	</div>
</PageLayout>
