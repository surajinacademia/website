---
import { researchPage } from "@/data/pages/research";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Research - Suraj Sahu",
	title: "Research",
};
---

<PageLayout meta={meta} searchable>
	<section aria-labelledby="research-title" class="mx-auto max-w-[1100px] [&_p]:text-justify">
		<h1 class="sr-only" id="research-title">Research</h1>

		<div class="space-y-36 sm:space-y-48">
			{
				researchPage.sections.map((section) => (
					<section>
						<h2 class="mb-14 text-2xl font-semibold tracking-tight sm:mb-16 sm:text-3xl">
							{section.title}
						</h2>

						<div class="space-y-28 sm:space-y-36">
							{section.groups.map((group) => (
								<div>
									{group.title && (
										<h3 class="mb-10 text-xl font-semibold tracking-tight sm:mb-12">
											{group.title}
										</h3>
									)}

									<div class="grid grid-cols-1 gap-x-20 gap-y-28 sm:gap-y-36 lg:grid-cols-2 xl:gap-x-24">
										{group.projects.map((project) => (
											<article class:list={["min-w-0", { "lg:col-span-2": project.wide }]}>
												{group.title ? (
													<h4 class="mb-6 text-xl font-semibold tracking-tight sm:mb-8">
														{project.title}
													</h4>
												) : (
													<h3 class="mb-6 text-xl font-semibold tracking-tight sm:mb-8">
														{project.title}
													</h3>
												)}

												{project.media && (
													<div
														class:list={[
															"mb-10",
															{
																"grid gap-6 sm:gap-10": project.media.length > 1,
															},
														]}
														style={
															project.media.length > 1
																? "grid-template-columns: " +
																	project.media
																		.map((media) => media.width / media.height + "fr")
																		.join(" ") +
																	";"
																: undefined
														}
													>
														{project.media.map((media) =>
															media.kind === "video" ? (
																<video
																	aria-label={project.title}
																	class="h-auto w-full"
																	controls
																	data-research-video
																	height={media.height}
																	loop
																	muted
																	playsinline
																	poster={media.poster}
																	preload="none"
																	width={media.width}
																>
																	<source src={media.src} type="video/mp4" />
																	Your browser does not support the video tag.
																</video>
															) : (
																<a
																	aria-label={"Open full-resolution " + media.alt}
																	class="block min-w-0"
																	href={media.src}
																	rel="noopener"
																	target="_blank"
																>
																	<img
																		alt={media.alt}
																		class="h-auto w-full object-contain"
																		decoding="async"
																		height={media.height}
																		loading="lazy"
																		src={media.src}
																		width={media.width}
																	/>
																</a>
															),
														)}
													</div>
												)}

												<div class="prose prose-base prose-cactus max-w-none">
													<p>
														{project.abstract}
														{project.experimentalVideoCredit && (
															<>
																{" "}
																Experimental video:{" "}
																<a
																	class="cactus-link"
																	href={project.experimentalVideoCredit.url}
																	rel="noopener"
																	target="_blank"
																>
																	{project.experimentalVideoCredit.label}
																</a>
																{"."}
															</>
														)}
														{project.mediaCredit && (
															<>
																{" "}
																{project.mediaCredit.prefix}{" "}
																<a
																	class="cactus-link"
																	href={project.mediaCredit.url}
																	rel="noopener"
																	target="_blank"
																>
																	{project.mediaCredit.label}
																</a>
																{"."}
															</>
														)}
													</p>
												</div>
												{project.publication && (
													<div class="mt-10 flex items-start gap-5 text-base leading-relaxed sm:gap-7">
														{project.media?.[0]?.kind === "image" && (
															<img
																alt=""
																class="h-auto w-20 shrink-0 rounded-sm sm:w-32"
																decoding="async"
																height={project.media[0].height}
																loading="lazy"
																src={project.media[0].src}
																width={project.media[0].width}
															/>
														)}
														<div class="min-w-0 flex-1">
															<cite class="block not-italic">
																<a
																	class="font-bold hover:underline"
																	href={project.publication.url}
																	rel="noopener"
																	target="_blank"
																>
																	{project.publication.title}
																</a>
															</cite>
															<div class="flex flex-wrap gap-x-1">
																{project.publication.authors.map((author, index, authors) => (
																	<span class:list={{ "font-bold": author.highlight }}>
																		{author.name + (index < authors.length - 1 ? "," : "")}
																	</span>
																))}
															</div>
															<div>
																<em>{project.publication.journal + ","}</em>{" "}
																{project.publication.date}
															</div>
															<div class="relative mt-3">
																<details>
																	<summary class="publication-action cursor-pointer list-none [&::-webkit-details-marker]:hidden">
																		ABS
																	</summary>
																	<p class="mt-5 leading-relaxed">{project.abstract}</p>
																</details>
																<a
																	class="publication-action absolute top-0 left-20"
																	href={project.publication.url}
																	rel="noopener"
																	target="_blank"
																>
																	HTML
																</a>
															</div>
														</div>
													</div>
												)}
											</article>
										))}
									</div>
								</div>
							))}
						</div>
					</section>
				))
			}
		</div>

		<p class="mt-20 text-sm leading-relaxed opacity-75">
			For a complete list of publications, visit my
			<a class="cactus-link" href={researchPage.scholarUrl} rel="noopener" target="_blank">
				Google Scholar profile
			</a>.
		</p>
	</section>
</PageLayout>

<script>
	const videos = document.querySelectorAll<HTMLVideoElement>("video[data-research-video]");
	const visibleVideos = new Set<HTMLVideoElement>();
	const userPaused = new WeakSet<HTMLVideoElement>();
	const automaticallyPaused = new WeakSet<HTMLVideoElement>();
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

	function updatePlayback(video: HTMLVideoElement) {
		if (document.hidden || !visibleVideos.has(video)) {
			if (!video.paused) {
				automaticallyPaused.add(video);
				video.pause();
			}
		} else if (!userPaused.has(video) && !reducedMotion.matches) {
			video.play().catch(() => {
				// Native controls remain available if the browser blocks autoplay.
			});
		}
	}

	const preloadObserver = new IntersectionObserver(
		(entries, observer) => {
			for (const entry of entries) {
				if (entry.isIntersecting) {
					(entry.target as HTMLVideoElement).preload = "auto";
					observer.unobserve(entry.target);
				}
			}
		},
		{ rootMargin: "400px 0px" },
	);

	const playbackObserver = new IntersectionObserver((entries) => {
		for (const entry of entries) {
			const video = entry.target as HTMLVideoElement;
			if (entry.isIntersecting) visibleVideos.add(video);
			else visibleVideos.delete(video);
			updatePlayback(video);
		}
	});

	for (const video of videos) {
		video.addEventListener("pause", () => {
			if (!automaticallyPaused.delete(video)) userPaused.add(video);
		});
		video.addEventListener("play", () => userPaused.delete(video));
		preloadObserver.observe(video);
		playbackObserver.observe(video);
	}

	document.addEventListener("visibilitychange", () => {
		for (const video of videos) updatePlayback(video);
	});
</script>

<style>
	.publication-action {
		display: inline-flex;
		min-width: 4rem;
		min-height: 2rem;
		align-items: center;
		justify-content: center;
		border: 1px solid currentColor;
		border-radius: 2px;
		padding: 0.25rem 0.75rem;
		font-size: 0.75rem;
		line-height: 1.5;
	}

	.publication-action:hover {
		text-decoration: underline;
	}

	.publication-action:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 3px;
	}
</style>
