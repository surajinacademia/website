---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "The requested page could not be found.",
	title: "Page not found",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">Page not found</h1>
	<p class="mb-6">This page may have moved, or the link may be incorrect.</p>
	<a class="cactus-link" href="/">Return to About</a>
</PageLayout>
