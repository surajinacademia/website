---
import { resourcesPage } from "@/data/pages/resources";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Open research software, reproducible code, and teaching resources by Suraj Sahu",
	title: "Resources",
};
---

<PageLayout meta={meta} searchable>
	<section aria-labelledby="resources-title" class="mx-auto max-w-[68ch]">
		<h1 class="title mb-8" id="resources-title">Resources</h1>
		<ol class="text-global-text list-decimal space-y-4 pl-6">
			{
				resourcesPage.resources.map((resource) => (
					<li class="pl-1">
						<a
							class="cactus-link focus-visible:outline-accent focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4"
							href={resource.href}
							rel="noopener noreferrer"
							target="_blank"
						>
							{resource.title}
						</a>
					</li>
				))
			}
		</ol>
	</section>
</PageLayout>
