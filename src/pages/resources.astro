---
import { resourcesPage } from "@/data/pages/resources";
import { resourceCategoryImages } from "@/data/pages/resources-images";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "MCPs, skills, tools, and practical research guides by Suraj Sahu.",
	title: "Resources",
};
---

<PageLayout meta={meta} searchable>
	<section aria-labelledby="resources-title" class="resources-page">
		<h1 id="resources-title">Resources</h1>
		<div class="resource-grid">
			{
				resourcesPage.categories.map((category, index) => {
					const photo = resourceCategoryImages[category.slug];
					return (
						<section class="resource-category" aria-labelledby={`${category.slug}-title`}>
							<a class="category-link" href={`/resources/${category.slug}/`}>
								{photo && (
									<div class="category-image">
										<img
											src={photo.src}
											width={photo.width}
											height={photo.height}
											alt=""
											loading={index < 2 ? "eager" : "lazy"}
											decoding="async"
											style={{ objectPosition: photo.position ?? "center" }}
										/>
									</div>
								)}
								<h2 class="category-label" id={`${category.slug}-title`}>
									{category.title}
								</h2>
							</a>
							{photo && (
								<p class="image-credit">
									<span>
										<a href={photo.sourceUrl}>
											<cite>{photo.artworkTitle}</cite>
										</a>
									</span>
									{photo.creditName}, {photo.date}
									{" · "}
									<a href={photo.licenseUrl}>{photo.licenseName}</a>
									{photo.modificationNote && <span>{photo.modificationNote}</span>}
								</p>
							)}
						</section>
					);
				})
			}
		</div>
	</section>
</PageLayout>

<style>
	.resources-page {
		width: 100%;
		max-width: 76rem;
		margin-inline: auto;
		font-family: "CMU Sans Serif", sans-serif;
	}
	.resources-page > h1 {
		margin-bottom: clamp(2rem, 4vw, 3.5rem);
		font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.2rem);
		font-weight: 600;
		line-height: 1.4;
		color: var(--color-accent-2);
	}
	.resource-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 3rem 1.75rem;
		align-items: start;
	}
	.resource-category {
		min-width: 0;
		text-align: center;
	}
	.category-link {
		position: relative;
		display: block;
		aspect-ratio: 1;
		overflow: hidden;
		text-decoration: none;
	}
	.category-image {
		position: absolute;
		inset: 0;
		background: color-mix(in srgb, var(--color-global-text) 5%, transparent);
	}
	.category-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.category-label {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		margin: 0;
		padding: 1.5rem;
		color: #fff;
		background: rgb(0 0 0 / 60%);
		font-size: clamp(1.4rem, 1.1rem + 0.7vw, 1.85rem);
		font-weight: 600;
		line-height: 1.35;
		text-wrap: balance;
		opacity: 1;
		transition: opacity 180ms ease;
	}
	@media (hover: hover) and (pointer: fine) {
		.category-label {
			opacity: 0;
		}
		.category-link:is(:hover, :focus-visible) .category-label {
			opacity: 1;
		}
	}
	@media (any-pointer: coarse) {
		.category-label {
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.category-label {
			transition: none;
		}
	}
	.resources-page a:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 5px;
	}
	.image-credit {
		margin-top: 0.75rem;
		font-size: 0.7rem;
		line-height: 1.6;
		color: var(--color-quote);
		overflow-wrap: anywhere;
	}
	.image-credit a {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.image-credit span {
		display: block;
	}
	@media (max-width: 1100px) {
		.resources-page {
			max-width: 48rem;
		}
		.resource-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 2rem;
		}
	}
	@media (max-width: 520px) {
		.resources-page {
			max-width: 24rem;
		}
		.resource-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
