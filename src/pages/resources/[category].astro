---
import { type ResourceCategory, resourcesPage } from "@/data/pages/resources";
import PageLayout from "@/layouts/Base.astro";

export function getStaticPaths() {
	return resourcesPage.categories.map((category) => ({
		params: { category: category.slug },
		props: { category },
	}));
}

interface Props {
	category: ResourceCategory;
}

const { category } = Astro.props;
const meta = {
	title: `${category.title} | Resources`,
	description: category.description,
};
---

<PageLayout meta={meta} searchable>
	<section class="resource-list-page" aria-labelledby="category-title">
		<nav class="back-navigation" aria-label="Back to Resources">
			<a href="/resources/">Resources</a>
		</nav>
		<h1 class="title" id="category-title">{category.title}</h1>
		<ul class="resource-list">
			{
				category.items.map((item) => {
					const external = item.href.startsWith("https://");
					return (
						<li>
							<a
								href={item.href}
								target={external ? "_blank" : undefined}
								rel={external ? "noopener noreferrer" : undefined}
							>
								{item.title}
								{external && <span class="sr-only"> (opens in a new tab)</span>}
							</a>
						</li>
					);
				})
			}
		</ul>
	</section>
</PageLayout>

<style>
	.resource-list-page {
		width: 100%;
		max-width: 68ch;
		margin-inline: auto;
		font-family: "CMU Sans Serif", sans-serif;
		color: var(--color-global-text);
		overflow-wrap: anywhere;
	}
	.back-navigation {
		margin-bottom: 1.75rem;
		font-size: 0.875rem;
	}
	.title {
		margin-bottom: 2rem;
		font-family: "CMU Sans Serif", sans-serif;
	}
	.resource-list-page a {
		color: var(--color-link);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.resource-list-page a:hover {
		text-decoration-thickness: 2px;
	}
	.resource-list-page a:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 4px;
	}
	.resource-list {
		margin: 0;
		list-style: none;
		padding: 0;
	}
	.resource-list li {
		font-size: 1.125rem;
		line-height: 1.6;
	}
	.resource-list li + li {
		margin-top: 1rem;
	}
</style>
