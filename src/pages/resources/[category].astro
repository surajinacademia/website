---
import { type ResourceCategory, resourcesPage } from "@/data/pages/resources";
import ReadingLayout from "@/layouts/Reading.astro";

export function getStaticPaths() {
	return resourcesPage.categories.map((category) => ({
		params: { category: category.slug },
		props: { category },
	}));
}

interface Props {
	category: ResourceCategory;
}

const { category } = Astro.props;
const meta = {
	title: `${category.title} | Resources`,
	description: category.description,
};
---

<ReadingLayout
	meta={meta}
	heading={category.title}
	parentLabel="Resources"
	parentHref="/resources/"
>
	{category.introduction && category.introduction.map((paragraph) => <p>{paragraph}</p>)}
	<ul class="resource-list">
		{
			category.items.map((item) => {
				const external = item.href.startsWith("https://");
				return (
					<li>
						<a
							href={item.href}
							target={external ? "_blank" : undefined}
							rel={external ? "noopener noreferrer" : undefined}
						>
							{item.title}
							{external && <span class="sr-only"> (opens in a new tab)</span>}
						</a>
						{category.slug === "skills" && <p>{item.description}</p>}
					</li>
				);
			})
		}
	</ul>
</ReadingLayout>
