---
import guideHtml from "@/content/how-to/literature-survey.html?raw";
import {
	type LiteratureSurveyImage,
	literatureSurveyImages,
} from "@/data/pages/literature-survey-images";
import ReadingLayout from "@/layouts/Reading.astro";

const escapeHtml = (value: string) =>
	value.replace(
		/[&<>"']/g,
		(character) =>
			({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[character] ??
			character,
	);

const photos = [...guideHtml.matchAll(/data-step-media="([a-z-]+)"/g)]
	.map((match) => literatureSurveyImages.find((photo) => photo.placement === match[1]))
	.filter((photo): photo is LiteratureSurveyImage => photo !== undefined);

const photoHtml = (photo: LiteratureSurveyImage) => `
	<figure class="guide-photo">
		<img src="${escapeHtml(photo.src)}" width="${photo.width}" height="${photo.height}"
			alt="${escapeHtml(photo.alt)}" loading="lazy" decoding="async" />
		<figcaption>${escapeHtml(photo.caption)}
			<sup><a href="#photo-credit-${escapeHtml(photo.placement)}" id="photo-credit-${escapeHtml(photo.placement)}-ref" aria-label="Image credit ${photos.indexOf(photo) + 1}">${photos.indexOf(photo) + 1}</a></sup>
		</figcaption>
	</figure>`;

const withPhotos = guideHtml.replace(
	/<div data-step-media="([a-z-]+)"><\/div>/g,
	(_, placement: string) => {
		const photo = literatureSurveyImages.find((item) => item.placement === placement);
		return photo ? photoHtml(photo) : "";
	},
);

const meta = {
	title: "Literature Survey like a Detective",
	description:
		"A literature survey, from following leads and collecting papers to connecting ideas and presenting your case.",
};
---

<ReadingLayout meta={meta} parentLabel="How to Series" parentHref="/resources/how-to/">
	<div set:html={withPhotos} />
	<section class="footnotes" aria-labelledby="image-credit-label">
		<h2 id="image-credit-label">Image credits</h2>
		<ol>
			{
				photos.map((photo, index) => (
					<li id={`photo-credit-${photo.placement}`}>
						<a href={photo.sourceUrl}>{photo.creditName}</a>.{" "}
						<a href={photo.licenseUrl}>{photo.licenseName}</a>.{" "}
						{photo.modificationNote && `${photo.modificationNote} `}
						<a
							href={`#photo-credit-${photo.placement}-ref`}
							aria-label={`Return to image ${index + 1}`}
						>
							↩
						</a>
					</li>
				))
			}
		</ol>
	</section>
</ReadingLayout>
