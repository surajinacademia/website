---
import guideHtml from "@/content/how-to/literature-survey.html?raw";
import {
	type LiteratureSurveyImage,
	literatureSurveyImages,
} from "@/data/pages/literature-survey-images";
import { literatureSurveyTools } from "@/data/pages/literature-survey-tools";
import PageLayout from "@/layouts/Base.astro";

const escapeHtml = (value: string) =>
	value.replace(
		/[&<>"']/g,
		(character) =>
			({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[character] ??
			character,
	);

const photoHtml = (photo: LiteratureSurveyImage) => `
	<figure class="guide-photo">
		<img src="${escapeHtml(photo.src)}" width="${photo.width}" height="${photo.height}"
			alt="${escapeHtml(photo.alt)}" loading="lazy" decoding="async" />
		<figcaption>${escapeHtml(photo.caption)}
			<span class="photo-credit"><a href="${escapeHtml(photo.sourceUrl)}">${escapeHtml(photo.creditName)}</a>
			· <a href="${escapeHtml(photo.licenseUrl)}">${escapeHtml(photo.licenseName)}</a>${photo.modificationNote ? ` · ${escapeHtml(photo.modificationNote)}` : ""}</span>
		</figcaption>
	</figure>`;

const withPhotos = guideHtml.replace(
	/<div data-step-media="([a-z-]+)"><\/div>/g,
	(_, placement: string) => {
		const photo = literatureSurveyImages.find((item) => item.placement === placement);
		return photo ? photoHtml(photo) : "";
	},
);
const toolsByUrl = new Map(
	literatureSurveyTools.map((tool) => [tool.url.replace(/\/$/, ""), tool]),
);
const articleHtml = withPhotos.replace(
	/<a\s+href="([^"]+)"\s*>([\s\S]*?)<\/a\s*>/g,
	(original, href: string, label: string) => {
		const tool = toolsByUrl.get(href.replace(/\/$/, ""));
		if (!tool) return original;
		return `<a class="tool-link" href="${escapeHtml(href)}"><img class="tool-logo" src="${escapeHtml(tool.logo)}" alt="" width="20" height="20" loading="lazy" decoding="async" />${label.trim()}</a>`;
	},
);

const meta = {
	title: "Literature Survey like a Detective",
	description:
		"A literature survey, from following leads and collecting papers to connecting ideas and presenting your case.",
};
---

<PageLayout meta={meta} searchable>
	<literature-walkthrough class="guide-layout">
		<article class="howto-article" aria-labelledby="guide-title">
			<header class="guide-header">
				<a class="guide-back" href="/resources/how-to/">How to Series</a>
				<h1 class="title" id="guide-title">Literature Survey like a Detective</h1>
			</header>
			<div class="guide-copy" set:html={articleHtml} />
		</article>
	</literature-walkthrough>
</PageLayout>

<script>
	class LiteratureWalkthrough extends HTMLElement {
		#controller: AbortController | undefined;

		connectedCallback() {
			this.#controller?.abort();
			this.#controller = new AbortController();
			const { signal } = this.#controller;
			const sections = [...this.querySelectorAll<HTMLDetailsElement>("details")];

			const revealHash = () => {
				let id: string;
				try {
					id = decodeURIComponent(window.location.hash.slice(1));
				} catch {
					return;
				}
				const target = document.getElementById(id);
				if (!target || !this.contains(target)) return;
				let ancestor: HTMLElement | null = target;
				while (ancestor && ancestor !== this) {
					if (ancestor instanceof HTMLDetailsElement) ancestor.open = true;
					ancestor = ancestor.parentElement;
				}
				const focusTarget =
					target instanceof HTMLDetailsElement
						? target.querySelector<HTMLElement>(":scope > summary")
						: target;
				if (focusTarget && focusTarget.tagName !== "SUMMARY")
					focusTarget.setAttribute("tabindex", "-1");
				focusTarget?.focus({ preventScroll: true });
				target.scrollIntoView({ block: "start" });
			};
			window.addEventListener("hashchange", revealHash, { signal });

			let beforePrint: boolean[] | undefined;
			window.addEventListener(
				"beforeprint",
				() => {
					if (beforePrint) return;
					beforePrint = sections.map((section) => section.open);
					for (const section of sections) section.open = true;
				},
				{ signal },
			);
			window.addEventListener(
				"afterprint",
				() => {
					if (!beforePrint) return;
					for (const [index, section] of sections.entries())
						section.open = beforePrint[index] ?? false;
					beforePrint = undefined;
				},
				{ signal },
			);
			if (window.location.hash) revealHash();
		}

		disconnectedCallback() {
			this.#controller?.abort();
		}
	}
	if (!customElements.get("literature-walkthrough"))
		customElements.define("literature-walkthrough", LiteratureWalkthrough);
</script>

<style>
	.guide-layout {
		--guide-level-2: var(--color-accent);
		--guide-level-3: #196565;
		--guide-level-4: #645080;
		display: block;
		width: 100%;
		max-width: 72ch;
		margin-inline: auto;
		font-family: "CMU Sans Serif", sans-serif;
		font-size: clamp(1rem, 0.97rem + 0.15vw, 1.05rem);
		color: var(--color-global-text);
		line-height: 1.5;
	}
	:global([data-theme="dark"] .guide-layout) {
		--guide-level-2: #bdd2f0;
		--guide-level-3: #aad8d3;
		--guide-level-4: #d5c1ed;
	}
	:global(.guide-layout a) {
		color: var(--color-link);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	:global(.guide-layout a:hover) {
		text-decoration-thickness: 2px;
	}
	:global(.guide-layout :is(a, summary):focus-visible) {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
		border-radius: 2px;
	}
	.howto-article {
		width: 100%;
		min-width: 0;
		overflow-wrap: anywhere;
	}
	.guide-header {
		margin-bottom: 1.25rem;
	}
	.guide-back {
		display: inline-block;
		font-size: 0.8rem;
		margin-bottom: 0.75rem;
	}

	:global(.guide-layout .guide-copy) {
		line-height: 1.5;
		text-wrap: pretty;
	}
	:global(.guide-layout .guide-copy p) {
		margin-block: 0.65rem;
	}
	:global(.guide-layout .guide-copy :is(ul, ol)) {
		margin-block: 0.6rem;
		padding-inline-start: clamp(1.1rem, 2.5vw, 1.5rem);
	}
	:global(.guide-layout .guide-copy ul) {
		list-style: disc;
	}
	:global(.guide-layout .guide-copy ol) {
		list-style: decimal;
	}
	:global(.guide-layout .guide-copy ol[type="a"]) {
		list-style: lower-alpha;
	}
	:global(.guide-layout .guide-copy li) {
		padding-inline-start: 0.15rem;
		margin-block: 0.35rem;
	}
	:global(.guide-layout .guide-copy li::marker) {
		color: var(--color-quote);
	}
	:global(.guide-layout .guide-copy details) {
		margin-block: 0.6rem;
	}
	:global(.guide-layout .guide-copy details[data-heading-level="2"]) {
		margin-top: 0.9rem;
	}
	:global(.guide-layout .guide-copy summary) {
		cursor: pointer;
		padding-block: 0.35rem;
		line-height: 1.35;
	}
	:global(.guide-layout .guide-copy summary :is(h2, h3, h4)) {
		display: inline;
		font-weight: 700;
		line-height: inherit;
		margin: 0;
	}
	:global(.guide-layout [data-heading-level="2"] > summary) {
		color: var(--guide-level-2);
		font-size: clamp(1.3rem, 1.15rem + 0.4vw, 1.5rem);
	}
	:global(.guide-layout [data-heading-level="3"] > summary) {
		color: var(--guide-level-3);
		font-size: clamp(1.12rem, 1rem + 0.3vw, 1.25rem);
	}
	:global(.guide-layout [data-heading-level="4"] > summary) {
		color: var(--guide-level-4);
		font-size: 1.05rem;
	}
	:global(.guide-layout .guide-copy strong) {
		font-weight: 700;
	}
	:global(.guide-layout [data-callout]) {
		padding: clamp(0.75rem, 2vw, 1rem);
		margin-block: 1rem;
		background: color-mix(in srgb, var(--color-link) 5%, transparent);
		border-inline-start: 2px solid var(--color-quote);
	}
	:global(.guide-layout [data-callout="abstract"]) {
		padding: 0;
		border: 0;
		background: none;
	}
	:global(.guide-layout [data-callout] > :first-child) {
		margin-top: 0;
	}
	:global(.guide-layout [data-callout] > :last-child) {
		margin-bottom: 0;
	}
	:global(.guide-layout .guide-photo) {
		margin-block: 1.25rem;
	}
	:global(.guide-layout .guide-photo img) {
		display: block;
		width: 100%;
		height: auto;
	}
	:global(.guide-layout .guide-photo figcaption) {
		margin-top: 0.5rem;
		font-size: 0.8rem;
		line-height: 1.4;
		color: var(--color-quote);
	}
	:global(.guide-layout .photo-credit) {
		display: block;
		font-size: 0.75rem;
		margin-top: 0.25rem;
	}
	:global(.guide-layout .tool-logo) {
		display: inline-block;
		width: 1.1em;
		height: 1.1em;
		margin-inline-end: 0.3em;
		padding: 0.1em;
		box-sizing: content-box;
		object-fit: contain;
		vertical-align: -0.27em;
		background: #fff;
		border-radius: 0.2em;
	}
	@media print {
		.guide-layout {
			display: block;
			max-width: none;
		}
		.guide-back {
			display: none;
		}
		:global(.guide-layout .howto-article details::details-content) {
			content-visibility: visible;
			display: block;
		}
		:global(.guide-layout .howto-article details > :not(summary)) {
			display: revert !important;
		}
		:global(.guide-layout summary) {
			break-after: avoid;
		}
		:global(.guide-layout .guide-photo) {
			break-inside: avoid;
		}
	}
</style>
