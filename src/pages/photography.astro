---
import fs from "node:fs";
import path from "node:path";
import { photoDescriptions } from "@/data/pages/photography";
import PageLayout from "@/layouts/Base.astro";
import "@fancyapps/ui/dist/fancybox/fancybox.css";

const meta = {
	description: "Photography and visual work by Suraj Sahu",
	title: "Photography",
};

const portfolioDir = path.join(process.cwd(), "public", "portfolio");
const imageFiles = fs.existsSync(portfolioDir)
	? fs
			.readdirSync(portfolioDir)
			.filter((f) => /\.(jpg|jpeg|png|webp|gif)$/i.test(f))
			.sort()
	: [];

// Reference layout: two columns (flex w-full md:w-1/2), items in each column are full or half width
const leftCol = imageFiles.filter((_, i) => i % 2 === 0);
const rightCol = imageFiles.filter((_, i) => i % 2 === 1);

function getItemWidthClass(index: number) {
	// Pattern: full, half, half, full, half, half...
	return index % 3 === 0 ? "w-full" : "w-full md:w-1/2";
}

function imageDescription(filename: string) {
	const description = photoDescriptions[filename];
	if (!description)
		throw new Error(`Add a photo description for ${filename} in src/data/pages/photography.ts`);
	return description;
}
---

<PageLayout meta={meta}>
	<div class="container mx-auto">
		<h1 class="title mb-8">Photography</h1>
		<section class="text-neutral-700 dark:text-neutral-300">
			<div class="container w-full">
				<div class="flex w-full flex-wrap">
					<!-- Left column -->
					<div class="flex w-full flex-wrap md:w-1/2">
						{
							leftCol.map((filename, i) => {
								const thumbFilename = filename.replace(/\.(jpg|jpeg|png)$/i, ".webp");
								const imageAlt = imageDescription(filename);
								return (
									<div class={`p-1 ${getItemWidthClass(i)}`}>
										<div class="portfolio-image-container h-full w-full overflow-hidden">
											<a
												href={`/portfolio/${filename}`}
												data-fancybox="gallery"
												data-caption={imageAlt}
												class="portfolio-link focus:ring-offset-global-bg dark:focus:ring-accent block cursor-pointer focus:ring-2 focus:ring-offset-2"
											>
												<img
													src={`/portfolio-thumbs/${thumbFilename}`}
													alt={imageAlt}
													class="portfolio-image block h-full w-full object-cover object-center"
													loading="lazy"
													decoding="async"
													width="800"
													height="600"
												/>
											</a>
										</div>
									</div>
								);
							})
						}
					</div>
					<!-- Right column -->
					<div class="flex w-full flex-wrap md:w-1/2">
						{
							rightCol.map((filename, i) => {
								const thumbFilename = filename.replace(/\.(jpg|jpeg|png)$/i, ".webp");
								const imageAlt = imageDescription(filename);
								return (
									<div class={`p-1 ${getItemWidthClass(i)}`}>
										<div class="portfolio-image-container h-full w-full overflow-hidden">
											<a
												href={`/portfolio/${filename}`}
												data-fancybox="gallery"
												data-caption={imageAlt}
												class="portfolio-link focus:ring-offset-global-bg dark:focus:ring-accent block cursor-pointer focus:ring-2 focus:ring-offset-2"
											>
												<img
													src={`/portfolio-thumbs/${thumbFilename}`}
													alt={imageAlt}
													class="portfolio-image block h-full w-full object-cover object-center"
													loading="lazy"
													decoding="async"
													width="800"
													height="600"
												/>
											</a>
										</div>
									</div>
								);
							})
						}
					</div>
				</div>
			</div>
		</section>
	</div>

	{
		imageFiles.length === 0 && (
			<div class="container mx-auto px-5 md:px-20">
				<p class="text-global-text/80 text-sm">No photographs have been published yet.</p>
			</div>
		)
	}
</PageLayout>

<script>
	import { Fancybox } from "@fancyapps/ui";

	document.addEventListener("DOMContentLoaded", () => {
		const shouldReduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		// Initialize Fancybox (options object typed to satisfy bind overload)
		Fancybox.bind("[data-fancybox]", {
			...(shouldReduceMotion
				? {
						dragToClose: false,
						hideClass: false,
						showClass: false,
						zoomEffect: false,
					}
				: {}),
			Toolbar: {
				display: {
					left: ["infobar"],
					middle: [],
					right: ["close"],
				},
			},
			Thumbs: {
				autoStart: false,
			},
			Image: {
				zoom: true,
				wheel: "slide",
			},
			Carousel: {
				...(shouldReduceMotion ? { transition: false } : {}),
				Navigation: {
					prevTpl:
						'<button class="fancybox__nav fancybox__nav--prev" title="Previous"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg></button>',
					nextTpl:
						'<button class="fancybox__nav fancybox__nav--next" title="Next"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></button>',
				},
			},
			closeButton: "top",
			backdrop: "classic",
		} as never);
	});
</script>

<style>
	.portfolio-link {
		cursor: zoom-in;
	}

	@media (prefers-reduced-motion: reduce) {
		/* Fancybox ships separate motion styles, so stop its remaining control/spinner effects too. */
		:global(.fancybox__container),
		:global(.fancybox__container *),
		:global(.fancybox__container *::before),
		:global(.fancybox__container *::after) {
			scroll-behavior: auto;
			/* biome-ignore lint/complexity/noImportantStyles: This must override Fancybox's higher-specificity motion rules. */
			animation: none !important;
			/* biome-ignore lint/complexity/noImportantStyles: This must override Fancybox's higher-specificity motion rules. */
			transition: none !important;
		}
	}
</style>
