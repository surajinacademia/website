---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Curriculum Vitae - Suraj Sahu",
	title: "CV",
};

const documents = [
	{
		description: "Complete academic history",
		href: "/cv.pdf",
		length: "Long version",
		title: "Academic CV",
	},
	{
		description: "Concise professional overview",
		href: "/resume.pdf",
		length: "Short version",
		title: "Résumé",
	},
];
---

<PageLayout meta={meta} searchable>
	<section aria-labelledby="cv-title" class="mx-auto max-w-2xl">
		<h1 class="title mb-5" id="cv-title">Curriculum Vitae</h1>
		<p class="text-global-text mb-8 opacity-75">Choose a PDF.</p>

		<div class="grid gap-3 sm:grid-cols-2">
			{
				documents.map((document) => (
					<a
						aria-label={`Open ${document.title} PDF in a new tab`}
						class="group text-global-text focus-visible:outline-accent flex min-h-40 flex-col justify-between rounded-lg border border-black/20 p-5 no-underline transition-colors duration-200 hover:border-black focus-visible:outline-2 focus-visible:outline-offset-4 dark:border-white/25 dark:hover:border-white"
						href={document.href}
						rel="noopener noreferrer"
						target="_blank"
					>
						<div>
							<p class="text-xs font-medium tracking-[0.16em] uppercase opacity-60">
								{document.length}
							</p>
							<h2 class="text-accent-2 mt-3 text-lg font-semibold">{document.title}</h2>
							<p class="mt-1 text-sm opacity-70">{document.description}</p>
						</div>
						<span class="mt-8 flex items-center justify-between text-sm font-medium">
							View PDF
							<span
								aria-hidden="true"
								class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
							>
								↗
							</span>
						</span>
					</a>
				))
			}
		</div>
	</section>
</PageLayout>
