---
import type { SiteMeta } from "@/types";
import BaseLayout from "./Base.astro";

interface Props {
	meta: SiteMeta;
	heading?: string;
	parentLabel?: string;
	parentHref?: string;
	searchable?: boolean;
}

const {
	meta,
	heading = meta.title,
	parentLabel = "Blog",
	parentHref = "/posts/",
	searchable = true,
} = Astro.props;
---

<BaseLayout meta={meta} searchable={searchable}>
	<div class="mx-auto w-full max-w-3xl">
		<nav
			aria-label="Breadcrumb"
			class="text-global-text mb-6 flex flex-wrap items-baseline gap-2 text-sm"
		>
			<a class="text-link hover:underline" href="/">Home</a>
			<span aria-hidden="true">/</span>
			{
				parentHref !== "/resources/" && parentHref.startsWith("/resources/") && (
					<>
						<a class="text-link hover:underline" href="/resources/">
							Resources
						</a>
						<span aria-hidden="true">/</span>
					</>
				)
			}
			<a class="text-link hover:underline" href={parentHref}>{parentLabel}</a>
		</nav>
		<article aria-labelledby="guide-title" data-pagefind-body={searchable || undefined}>
			<header class="mb-8" id="blog-hero">
				<slot name="header"><h1 class="title pt-2 pb-0" id="guide-title">{heading}</h1></slot>
			</header>
			<div class="reading-copy"><slot /></div>
		</article>
	</div>
</BaseLayout>
