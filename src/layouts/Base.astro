---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SkipLink from "@/components/SkipLink.astro";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
	searchable?: boolean;
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title },
	searchable = false,
} = Astro.props;
---

<html class="scroll-smooth" data-theme="dark" id="site-root" lang={siteConfig.lang}>
	<head>
		<BaseHead articleDate={articleDate} description={description} ogImage={ogImage} title={title} />
	</head>
	<body
		class="animate-fade-in flex min-h-screen w-full flex-col bg-white px-5 pt-10 text-[15px] font-normal text-black antialiased transition duration-500 motion-reduce:transition-none md:px-20 dark:bg-black dark:text-white"
	>
		<SkipLink />
		<Header />
		<main class="pb-8" data-pagefind-body={searchable || undefined} id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
